// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STAFF
  REVIEWER
}

enum RequestStatus {
  DRAFT
  PENDING_REVIEW
  SUBMITTED
  IN_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  DENIED
  PENDED
  REJECTED
  SERVICE_COMPLETED
}

model User {
  id    String @id @default(cuid())
  name  String
  email String @unique
  role  Role
}

model Patient {
  id        String             @id @default(cuid())
  firstName String
  lastName  String
  dob       DateTime
  gender    String
  memberId  String
  payerName String
  requests  PriorAuthRequest[]
}

model PriorAuthRequest {
  id                         String        @id @default(cuid())
  controlNumber              Int           @unique @default(autoincrement()) // X12 ISA13/GS06/ST02
  status                     RequestStatus @default(DRAFT)
  patientId                  String
  patient                    Patient       @relation(fields: [patientId], references: [id])
  providerName               String
  providerNpi                String
  diagnosisCode              String
  procedureCode              String
  serviceDate                DateTime
  unitsRequested             Int           @default(1)
  unitsApproved              Int? // set only when the payer approves or partially approves
  clinicalNotesAttached      Boolean       @default(false)
  conservativeTreatmentTried Boolean       @default(false)
  raw278Request              String?
  raw278Response             String?
  decisionReason             String? // payer's reason for denial, pend, rejection, or partial approval
  decisionAt                 DateTime?
  authorizationNumber        String? // payer's authorization number (approved / partially approved)
  createdById                String
  reviewedById               String?
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt
  auditLogs                  AuditLog[]
}

model AuditLog {
  id        String           @id @default(cuid())
  requestId String
  request   PriorAuthRequest @relation(fields: [requestId], references: [id])
  actor     String
  action    String
  details   String?
  createdAt DateTime         @default(now())
}

// ---------------------------------------------------------------------------
// Simulated payer ("mock payer") tables. Only lib/payer/* reads or writes these;
// the hospital side never touches them (see README, "How the hospital and the
// simulated payer talk"). Nothing here references hospital tables.
// ---------------------------------------------------------------------------

enum PayerMessageStatus {
  RECEIVED
  IN_REVIEW
  RESPONDED
}

enum PayerMode {
  AUTO
  MANUAL
}

/// Payer's eligibility roster (synthetic)
model PayerMember {
  id       String  @id @default(cuid())
  memberId String  @unique
  payerId  String
  active   Boolean @default(true)
}

/// One inbound 278 request and the payer's handling of it
model PayerMessage {
  id                  String             @id @default(cuid())
  /// Payer-side counter: response ISA13/GS06/ST02 and the authorization number
  controlNumber       Int                @unique @default(autoincrement())
  status              PayerMessageStatus @default(RECEIVED)
  requestEdi          String
  /// Simulated X12 275 attachment flags sent alongside the 278
  attachments         Json
  receivedAt          DateTime           @default(now())
  acknowledgeAt       DateTime
  respondAt           DateTime
  responseEdi         String?
  outcome             String?
  respondedAt         DateTime?
  deliveredAt         DateTime?
  authorizationNumber String?

  @@index([status])
}

/// Single row (id = 1)
model PayerSettings {
  id                   Int       @id @default(1)
  mode                 PayerMode @default(AUTO)
  ackDelaySeconds      Int       @default(2)
  responseDelaySeconds Int       @default(8)
}
